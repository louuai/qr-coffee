                         "express":  "^4.21.2",
                         "express-validator":  "^6.14.3",
                         "helmet":  "^8.1.0",
                         "jsonwebtoken":  "^9.0.0",
                         "mysql2":  "^3.2.0",
                         "qrcode":  "^1.5.1",
                         "sequelize":  "^6.32.1",
                         "socket.io":  "^4.8.1",
                         "winston":  "^3.9.0"
                     },
    "devDependencies":  {
                            "@types/bcrypt":  "^6.0.0",
                            "@types/express":  "^4.17.17",
                            "@types/jest":  "^29.5.3",
                            "@types/jsonwebtoken":  "^9.0.2",
                            "@types/node":  "^20.19.24",
                            "jest":  "^29.6.1",
                            "ts-jest":  "^29.1.1",
                            "ts-node":  "^10.9.2",
                            "ts-node-dev":  "^2.0.0",
                            "typescript":  "^5.9.3"
                        }
}
