{
    "name":  "rasops-qr-backend",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "ts-node-dev --respawn --transpile-only src/server.ts",
                    "build":  "tsc -p .",
                    "start":  "node --no-warnings dist/server.js",
                    "migrate":  "sequelize db:migrate",
                    "seed":  "ts-node src/seeders/seed-demo.ts",
                    "test":  "jest --runInBand"
                },
